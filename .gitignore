# Local Scratch account metadata and saved server responses.
scratch-upload.json
shared-metadata*.json

# Historical publishing helpers contain a hardcoded account name. Keep these
# copies locally; the archived game generators and Scratch projects stay public.
/archive/**/source/generator/tools/upload_scratch.py

# Local Scratch test build with capture controls.
/dist/testing/

# Local credentials/configuration and generated Python bytecode.
.env
.env.*
!.env.example
*.local.json
__pycache__/
*.py[cod]

# Git administration data from vendored repositories is not project source.
**/.git/
**/.git-local-metadata/

# Outputs written by the test and capture scripts. Commit a screenshot
# deliberately with `git add -f` when it documents a change.
/artifacts/*.json
/artifacts/demo-track-code.txt
/artifacts/acceleration-*
/artifacts/confirm-*.png
/artifacts/desktop-*.png
/artifacts/fullscreen-*.png
/artifacts/load-code-*.png
/artifacts/save-code-*.png
/artifacts/mobile-*.png
/artifacts/menus-*.png
/artifacts/prompt-*.png
/artifacts/sprites-*
/artifacts/converter-*.png
/artifacts/scratch-*
/artifacts/settings-test-*
/tools/__pycache__/
